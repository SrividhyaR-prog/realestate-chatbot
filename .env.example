# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# openrouter/free picks any currently available free model, so the app survives free models being retired.
OPENROUTER_MODEL=openrouter/free
# Optional comma-separated fallbacks, tried in order (must end in :free to stay free), e.g.
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free

# Public URL of the deployment (sent to OpenRouter as the referer)
APP_URL=http://localhost:7860

# Per-visitor limit protecting the free quota: requests per window (seconds)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=600
